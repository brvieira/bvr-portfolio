---
import { render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { getPublishedPosts, getReadingTime } from "../../utils/content";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const readingTime = await getReadingTime(post);
---

<ArticleLayout
  titulo={post.data.titulo}
  categoria={post.data.categoria}
  data={post.data.data}
  tempoLeitura={readingTime}
  resumo={post.data.resumo}
  headings={headings}
  ogImage={`/og/blog/${post.id}.png`}
>
  <Content />
</ArticleLayout>
