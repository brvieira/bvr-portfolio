---
import BaseLayout from "./BaseLayout.astro";
import ArticleToc from "../components/ArticleToc.astro";
import AuthorSignature from "../components/AuthorSignature.astro";
import { formatDateLong } from "../utils/format-date";
import { blogCategories, person } from "../data/site";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  titulo: string;
  categoria: string;
  data: Date;
  tempoLeitura: number;
  resumo: string;
  headings: Heading[];
  ogImage?: string;
}

const { titulo, categoria, data, tempoLeitura, resumo, headings, ogImage } = Astro.props;
const categoryLabel = blogCategories.find((c) => c.slug === categoria)?.label ?? categoria;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: titulo,
  description: resumo,
  datePublished: data.toISOString(),
  author: { "@type": "Person", name: person.name },
  url: new URL(Astro.url.pathname, Astro.site).toString(),
};
---

<BaseLayout title={`${titulo} · Bruno Vieira`} description={resumo} ogImage={ogImage} jsonLd={jsonLd}>
  <div class="article-page">
    <a href="/blog/" class="back-link">← Blog</a>
    <div class="article-grid">
      <article class="article-col">
        <div class="meta-row">
          <span class="category">{categoryLabel}</span>
          <span class="dot" aria-hidden="true"></span>
          <span class="meta-text">{formatDateLong(data)} · {tempoLeitura} min de leitura</span>
        </div>
        <h1 class="article-title">{titulo}</h1>
        <p class="lead">{resumo}</p>
        <div class="divider"></div>
        <div class="prose">
          <slot />
        </div>
        <AuthorSignature />
      </article>
      <ArticleToc headings={headings} />
    </div>
  </div>
</BaseLayout>

<style>
  .article-page {
    max-width: 1080px;
    margin: 0 auto;
    padding: 56px 32px 96px;
  }

  .back-link {
    display: inline-block;
    font-size: 13.5px;
    color: var(--text-muted);
    margin-bottom: 36px;
  }
  .back-link:hover {
    color: var(--text);
  }

  .article-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 200px;
    gap: 64px;
    align-items: start;
  }

  .article-col {
    /* min-width: 0 lets this grid item shrink below the <pre> code block's
       min-content width; otherwise the grid track (and the whole page)
       widens to fit unbroken code lines instead of letting `pre` scroll. */
    min-width: 0;
    max-width: min(68ch, 100%);
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
  }

  .category {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--border-hover);
  }

  .meta-text {
    font-size: 13px;
    color: var(--text-meta);
  }

  .lead {
    margin-top: 34px;
  }

  .divider {
    height: 1px;
    background: var(--border);
    margin: 34px 0;
  }

  .prose :global(p) {
    font-size: 17px;
    line-height: 1.72;
    color: var(--text-body);
    text-wrap: pretty;
    margin: 0 0 22px;
  }

  .prose :global(h2) {
    font-size: 25px;
    line-height: 1.25;
    letter-spacing: -0.02em;
    font-weight: 700;
    color: var(--text);
    margin: 40px 0 16px;
  }

  .prose :global(code) {
    font-family: "JetBrains Mono", monospace;
    font-size: 14.5px;
    background: var(--inline-code-bg);
    padding: 2px 6px;
    border-radius: 5px;
    color: var(--accent-soft);
  }

  .prose :global(pre code) {
    background: transparent;
    padding: 0;
    color: inherit;
  }

  .prose :global(blockquote) {
    border-left: 2px solid var(--accent);
    background: var(--callout-bg);
    border-radius: 0 10px 10px 0;
    padding: 18px 22px;
    margin: 0 0 26px;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--text-body);
  }
  .prose :global(blockquote p) {
    margin: 0;
  }

  .prose :global(.code-block) {
    margin: 0 0 26px;
  }

  @media (max-width: 1023px) {
    .article-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>

<script src="../scripts/copy-code.ts"></script>

