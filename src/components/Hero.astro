---
import { Image } from "astro:assets";
import IconGithub from "./icons/IconGithub.astro";
import IconLinkedin from "./icons/IconLinkedin.astro";
import IconEmail from "./icons/IconEmail.astro";
import profilePhoto from "../assets/profile.jpg";
import { hero, person } from "../data/site";

const titleLines = hero.title.split("\n");
---

<section class="hero">
  <div class="hero-inner">
    <div class="hero-copy">
      <div class="badge">
        <span class="dot" aria-hidden="true"></span>
        {hero.badge}
      </div>
      <h1 class="hero-title">
        {titleLines.map((line, i) => (
          <>
            {line}
            {i < titleLines.length - 1 && <br />}
          </>
        ))}
      </h1>
      <p class="lead">{hero.leadParagraph}</p>
      <p class="support">{hero.supportParagraph}</p>
      <div class="cta-row">
        <a href="/projetos/" class="btn-primary">Ver projetos e demos</a>
        <a href="/sobre/" class="btn-secondary">Trajetória completa</a>
      </div>
      <div class="contact-row">
        <a href={person.github} target="_blank" rel="noopener" class="contact-link">
          <IconGithub size={15} />
          {person.githubHandle}
        </a>
        <a href={person.linkedin} target="_blank" rel="noopener" class="contact-link">
          <IconLinkedin size={15} />
          LinkedIn
        </a>
        <a href={`mailto:${person.email}`} class="contact-link">
          <IconEmail size={15} />
          {person.email}
        </a>
      </div>
    </div>
    <div class="hero-side">
      <Image
        src={profilePhoto}
        alt={person.name}
        width={536}
        height={632}
        class="hero-photo"
        loading="eager"
      />
      <div class="role-card">
        <div class="role-label">Cargo atual</div>
        <div class="role-title">{person.role}</div>
        <div class="role-company">{person.company}</div>
        <div class="role-city">{person.city}</div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    border-bottom: 1px solid var(--border);
    background: linear-gradient(180deg, var(--hero-gradient-from) 0%, var(--hero-gradient-to) 100%);
  }

  .hero-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 88px 32px 64px;
    display: grid;
    grid-template-columns: 1fr 268px;
    gap: 60px;
    align-items: start;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 6px 13px 6px 9px;
    border: 1px solid var(--role-badge-border);
    background: var(--role-badge-bg);
    border-radius: 999px;
    font-size: 12.5px;
    color: var(--accent-soft);
    margin-bottom: 28px;
    letter-spacing: 0.01em;
  }
  .badge .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .hero-title {
    margin-bottom: 24px;
  }

  .lead {
    font-size: 19px;
    line-height: 1.65;
    color: var(--text-body);
    max-width: min(52ch, 100%);
    text-wrap: pretty;
    margin-bottom: 18px;
  }

  .support {
    font-size: 16.5px;
    line-height: 1.68;
    color: var(--text-muted);
    max-width: min(54ch, 100%);
    text-wrap: pretty;
    margin-bottom: 32px;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 34px;
  }

  .btn-primary {
    padding: 12px 20px;
    border-radius: 10px;
    background: var(--accent);
    color: #06120c;
    font-size: 14.5px;
    font-weight: 700;
    transition: background-color 150ms ease-out;
  }
  .btn-primary:hover {
    background: var(--accent-soft);
    color: #06120c;
  }

  .btn-secondary {
    padding: 12px 20px;
    border-radius: 10px;
    border: 1px solid var(--border-hover);
    color: var(--text);
    font-size: 14.5px;
    font-weight: 500;
    transition: border-color 150ms ease-out;
  }
  .btn-secondary:hover {
    border-color: var(--accent);
  }

  .contact-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 9px 14px;
    border: 1px solid var(--border);
    border-radius: 9px;
    font-size: 13.5px;
    color: var(--text-body);
    transition: border-color 150ms ease-out, color 150ms ease-out;
  }
  .contact-link:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .hero-side {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .hero-photo {
    width: 268px;
    height: 316px;
    border-radius: 14px;
    border: 1px solid var(--border-hover);
    object-fit: cover;
    display: block;
  }

  .role-card {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px 18px;
    background: var(--surface);
  }

  .role-label {
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-meta);
    margin-bottom: 10px;
  }

  .role-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--text);
    line-height: 1.35;
  }

  .role-company {
    font-size: 14px;
    color: var(--accent);
    margin-top: 3px;
  }

  .role-city {
    font-size: 12.5px;
    color: var(--text-meta);
    margin-top: 8px;
    font-family: "JetBrains Mono", monospace;
  }

  @media (max-width: 1023px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .hero-side {
      order: -1;
      flex-direction: row;
      align-items: flex-start;
    }
  }

  @media (max-width: 767px) {
    .hero-inner {
      padding: 56px 20px 48px;
    }
    .hero-side {
      flex-direction: column;
    }
    .hero-photo {
      width: 100%;
      max-width: 268px;
    }
  }
</style>
