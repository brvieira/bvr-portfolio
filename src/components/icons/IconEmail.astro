  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <rect x="2.5" y="5" width="19" height="14" rx="2.5"></rect>
  <path d="M3.5 7l8.5 6 8.5-6"></path>
</svg>
